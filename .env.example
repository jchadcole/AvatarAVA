# Copy to .env for local runs. In a Claude cloud environment, set these as
# environment variables instead. Never commit real keys.

# Claude (the conversation brain and guardrail classifier)
ANTHROPIC_API_KEY=
# Use this name instead where ANTHROPIC_API_KEY is reserved (Claude cloud environments).
AVA_ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Fast model for the input safety classifier.
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5

# LiveAvatar (Avatar Only / LITE mode)
LIVEAVATAR_API_KEY=
# Sandbox mode is free but only works with the "Wayne" avatar and ends after ~1 minute.
LIVEAVATAR_SANDBOX=true
# Optional override; normally set "avatarId" in shows/<show>/show.json. Ignored in sandbox mode.
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VIDEO_QUALITY=high

# Deepgram (speech-to-text and text-to-speech)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Optional override; normally set "voice" in shows/<show>/show.json.
DEEPGRAM_TTS_MODEL=

# ElevenLabs (premium voice). When the key is set the host speaks with ElevenLabs,
# and Deepgram takes over automatically for any line ElevenLabs fails or is slow on.
ELEVENLABS_API_KEY=
# Optional override; normally set "elevenLabsVoiceId" in shows/<show>/show.json.
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is the fastest; eleven_multilingual_v2 is richer but slower.
ELEVENLABS_MODEL=eleven_flash_v2_5

# Genesys AVA (optional brain). Normally set "brain" and "genesys" in shows/<show>/show.json;
# these override it. Not secret, but keep them here if you'd rather not commit them.
# AVA_BRAIN=genesys
GENESYS_REGION=
GENESYS_DEPLOYMENT_ID=

# Kiosk
SHOW=demo
PORT=3000
KIOSK_ID=booth-1
LOG_DIR=logs
